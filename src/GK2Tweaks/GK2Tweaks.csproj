<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <LocalPropsPath>$(MSBuildThisFileDirectory)..\..\build\Local.props</LocalPropsPath>
    <HasLocalProps Condition="Exists('$(LocalPropsPath)')">true</HasLocalProps>
    <HasLocalProps Condition="'$(HasLocalProps)' == ''">false</HasLocalProps>
  </PropertyGroup>

  <Import
      Project="$(LocalPropsPath)"
      Condition="'$(HasLocalProps)' == 'true'" />

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>

    <AssemblyName>GK2Tweaks</AssemblyName>
    <RootNamespace>GK2Tweaks</RootNamespace>

    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Graveyard Keeper 2</GameDir>
    <GameDataDir Condition="'$(GameDataDir)' == ''">$(GameDir)\GraveyardKeeper2_Data</GameDataDir>
    <BepInExDir Condition="'$(BepInExDir)' == ''">$(GameDir)\BepInEx</BepInExDir>
    <FrameworkDll Condition="'$(FrameworkDll)' == ''">$(BepInExDir)\plugins\GK2.Framework.dll</FrameworkDll>
    <GameExecutable Condition="'$(GameExecutable)' == ''">$(GameDir)\GraveyardKeeper2.exe</GameExecutable>

    <DeployToGame Condition="'$(DeployToGame)' == '' and '$(Configuration)' == 'Debug' and '$(HasLocalProps)' == 'true'">true</DeployToGame>
    <DeployToGame Condition="'$(DeployToGame)' == ''">false</DeployToGame>
    <RunGameAfterDeploy Condition="'$(RunGameAfterDeploy)' == '' and '$(DeployToGame)' == 'true' and '$(Configuration)' == 'Debug'">true</RunGameAfterDeploy>
    <RunGameAfterDeploy Condition="'$(RunGameAfterDeploy)' == ''">false</RunGameAfterDeploy>
    <ModDeployDir Condition="'$(ModDeployDir)' == ''">$(BepInExDir)\plugins\GK2Tweaks</ModDeployDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="GK2.Framework">
      <HintPath>$(FrameworkDll)</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="BepInEx">
      <HintPath>$(BepInExDir)\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameDataDir)\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine">
      <HintPath>$(GameDataDir)\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameDataDir)\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateLocalSdk" BeforeTargets="ResolveReferences">
    <Message Importance="high"
             Text="GK2Tweaks local build: Configuration=$(Configuration), GameDir=$(GameDir), DeployToGame=$(DeployToGame), RunGameAfterDeploy=$(RunGameAfterDeploy)" />
    <Error
        Condition="!Exists('$(BepInExDir)\core\BepInEx.dll')"
        Text="BepInEx.dll was not found. Copy build\Local.props.example to build\Local.props and set GameDir to your Graveyard Keeper 2 installation." />
    <Error
        Condition="!Exists('$(FrameworkDll)')"
        Text="GK2.Framework.dll was not found at '$(FrameworkDll)'. Install GK2 Mod Framework or override FrameworkDll in build\Local.props." />
    <Error
        Condition="!Exists('$(GameDataDir)\Managed\Assembly-CSharp.dll')"
        Text="Assembly-CSharp.dll was not found under '$(GameDataDir)\Managed'. Check GameDir in build\Local.props." />
    <Error
        Condition="!Exists('$(GameDataDir)\Managed\UnityEngine.dll')"
        Text="UnityEngine.dll was not found under '$(GameDataDir)\Managed'. Check GameDir in build\Local.props." />
    <Error
        Condition="'$(DeployToGame)' == 'true' and '$(RunGameAfterDeploy)' == 'true' and !Exists('$(GameExecutable)')"
        Text="Game executable was not found at '$(GameExecutable)'. Check GameDir or override GameExecutable in build\Local.props." />
  </Target>

  <Target Name="DeployBuiltMod"
          AfterTargets="Build"
          Condition="'$(DeployToGame)' == 'true'">
    <MakeDir Directories="$(ModDeployDir)" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFiles="$(ModDeployDir)\$(TargetFileName)"
          SkipUnchangedFiles="false" />
    <Message Importance="high"
             Text="GK2Tweaks deployed: $(TargetPath) -> $(ModDeployDir)\$(TargetFileName)" />
    <Message Condition="'$(RunGameAfterDeploy)' == 'true'"
             Importance="high"
             Text="GK2Tweaks launching: $(GameExecutable)" />
    <Exec Condition="'$(RunGameAfterDeploy)' == 'true'"
          WorkingDirectory="$(GameDir)"
          Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;$processName = [System.IO.Path]::GetFileNameWithoutExtension('$(GameExecutable)'); if (-not (Get-Process -Name $processName -ErrorAction SilentlyContinue)) { Start-Process -FilePath '$(GameExecutable)' -WorkingDirectory '$(GameDir)' }&quot;" />
  </Target>

</Project>
